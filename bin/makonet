#!/usr/bin/env bash
# ==============================================================================
# makonet: Ultra-lightweight network & telemetry HUD for Mako / Wayland
# Author: Alice & Antigravity
# License: MIT
# Toggle with Mod+Shift+Ctrl+Backspace in niri
# ==============================================================================

APP_NAME="makonet"
PID_FILE="/tmp/makonet.pid"
NOTIF_ID_FILE="/tmp/makonet.nid"
PREV_DEV_FILE="/tmp/makonet.dev"

# ------------------------------------------------------------------------------
# NOTIFICATION HELPERS
# ------------------------------------------------------------------------------
notify_msg() {
    local title="$1"
    local body="$2"
    local timeout="${3:-3000}"
    busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
        org.freedesktop.Notifications Notify susssasa{sv}i \
        "$APP_NAME" 0 "" "$title" "$body" 0 0 "$timeout" >/dev/null 2>&1 || true
}

dismiss_makonet() {
    makoctl list 2>/dev/null | awk -v app="$APP_NAME" '
        /^Notification [0-9]+:/ { id = $2; sub(":", "", id) }
        $0 ~ ("App name: " app) { system("makoctl dismiss -n " id " 2>/dev/null") }
    '
}

# ------------------------------------------------------------------------------
# FORMATTING HELPERS
# ------------------------------------------------------------------------------
human_bytes() {
    local b="${1:-0}"
    awk -v b="$b" 'BEGIN {
        b = b + 0;
        if (b >= 1073741824) printf "%.1f GiB", b / 1073741824;
        else if (b >= 1048576) printf "%.1f MiB", b / 1048576;
        else if (b >= 1024) printf "%.1f KiB", b / 1024;
        else printf "%d B", b;
    }'
}

human_rate() {
    local bytes_diff="${1:-0}"
    local dt="${2:-1.0}"
    awk -v b="$bytes_diff" -v dt="$dt" 'BEGIN {
        dt = dt + 0; if (dt <= 0) dt = 1.0;
        bps = b / dt;
        if (bps >= 1048576) printf "%.1f MB/s", bps / 1048576;
        else if (bps >= 1024) printf "%.1f KB/s", bps / 1024;
        else printf "%d B/s", bps;
    }'
}

make_bar() {
    local pct="${1:-0}"
    local width="${2:-10}"
    local is_pango="$3"

    pct=$(( pct + 0 ))
    [ "$pct" -lt 0 ] && pct=0
    [ "$pct" -gt 100 ] && pct=100

    local filled=$(( (pct * width + 50) / 100 ))
    [ "$filled" -gt "$width" ] && filled=$width
    local empty=$(( width - filled ))

    # Catppuccin Mocha thresholds
    local col_hex="#a6e3a1"  # Green
    local col_ansi="\033[32m"
    if [ "$pct" -lt 40 ]; then
        col_hex="#f38ba8"    # Red
        col_ansi="\033[31m"
    elif [ "$pct" -lt 65 ]; then
        col_hex="#fab387"    # Peach
        col_ansi="\033[33m"
    fi

    local fstr=""
    local estr=""
    for ((i = 0; i < filled; i++)); do fstr="${fstr}█"; done
    for ((i = 0; i < empty; i++)); do estr="${estr}░"; done

    if [ "$is_pango" -eq 1 ]; then
        printf "<span foreground=\"%s\">%s</span><span foreground=\"#45475a\">%s</span>" "$col_hex" "$fstr" "$estr"
    else
        printf "%b%s\033[90m%s\033[0m" "$col_ansi" "$fstr" "$estr"
    fi
}

# ------------------------------------------------------------------------------
# CORE DATA EXTRACTION
# ------------------------------------------------------------------------------
gather_network_data() {
    local is_pango="$1"
    local is_live="$2"
    local dt="${3:-2.0}"

    # 1. Routing & Default Interface
    local route_line
    route_line=$(ip route show default 2>/dev/null | head -n 1)
    local def_gw def_iface
    def_gw=$(awk '{for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' <<< "$route_line")
    def_iface=$(awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' <<< "$route_line")

    if [ -z "$def_iface" ]; then
        def_iface=$(ip -o link show up 2>/dev/null | awk -F': ' '$2 != "lo" && $2 !~ /^tailscale/ {print $2; exit}')
    fi

    # Local IP Address
    local local_ip=""
    if [ -n "$def_iface" ]; then
        local_ip=$(ip -4 -o addr show dev "$def_iface" 2>/dev/null | awk '{print $4; exit}')
    fi
    [ -z "$local_ip" ] && local_ip="No IP"

    # 2. Ping Latency (Parallel with tight 0.5s timeout)
    local ping_tmpdir
    ping_tmpdir=$(mktemp -d /tmp/makonet_ping.XXXXXX)
    if [ -n "$def_gw" ]; then
        ping -c 1 -W 0.5 "$def_gw" 2>/dev/null | awk -F'/' '/rtt/ {printf "%.1f", $5}' > "$ping_tmpdir/gw" &
    fi
    ping -c 1 -W 0.5 1.1.1.1 2>/dev/null | awk -F'/' '/rtt/ {printf "%.1f", $5}' > "$ping_tmpdir/inet" &
    wait

    local gw_rtt inet_rtt
    gw_rtt=$(cat "$ping_tmpdir/gw" 2>/dev/null)
    inet_rtt=$(cat "$ping_tmpdir/inet" 2>/dev/null)
    rm -rf "$ping_tmpdir"

    # 3. Wi-Fi Telemetry via nmcli (rescan no = instant & no packet loss)
    local is_wifi=0
    local wifi_ssid="" wifi_chan="" wifi_freq="" wifi_rate="" wifi_sig=0 wifi_sec=""
    if [ -n "$def_iface" ] && [[ "$def_iface" =~ ^wl ]]; then
        is_wifi=1
        local wifi_row
        wifi_row=$(nmcli -t -f in-use,ssid,chan,freq,rate,signal,security dev wifi list --rescan no 2>/dev/null | grep "^\*:" | head -n 1)
        if [ -n "$wifi_row" ]; then
            IFS=':' read -r _ wifi_ssid wifi_chan wifi_freq wifi_rate wifi_sig wifi_sec <<< "$wifi_row"
        fi
    fi

    # Wi-Fi Band simplification
    local wifi_band=""
    if [ -n "$wifi_freq" ]; then
        local freq_num="${wifi_freq%% *}"
        if [ "$freq_num" -ge 5000 ] 2>/dev/null; then
            wifi_band="5 GHz"
        elif [ "$freq_num" -ge 2400 ] 2>/dev/null; then
            wifi_band="2.4 GHz"
        fi
    fi

    # 4. Tailscale Telemetry
    local tail_ip tail_status="offline"
    tail_ip=$(tailscale ip -4 2>/dev/null | head -n 1)
    if [ -n "$tail_ip" ]; then
        local ts_peers
        ts_peers=$(tailscale status 2>/dev/null | awk '$5=="-" && $2!="netbook" {print $2}')
        local peer_count=0
        [ -n "$ts_peers" ] && peer_count=$(wc -w <<< "$ts_peers")

        if [ "$peer_count" -gt 0 ]; then
            local first_peer
            first_peer=$(head -n 1 <<< "$ts_peers")
            if [ "$peer_count" -eq 1 ]; then
                tail_status="${first_peer} online"
            else
                tail_status="${peer_count} peers (${first_peer})"
            fi
        else
            tail_status="active (0 peers)"
        fi
    fi

    # 5. Interface I/O & Rates from /proc/net/dev
    local cur_rx=0 cur_tx=0
    if [ -n "$def_iface" ]; then
        read -r cur_rx cur_tx <<< $(awk -v iface="${def_iface}:" '$1==iface {print $2, $10}' /proc/net/dev 2>/dev/null)
    fi
    cur_rx="${cur_rx:-0}"
    cur_tx="${cur_tx:-0}"

    local rx_rate_str="" tx_rate_str=""
    if [ "$is_live" -eq 1 ] && [ -f "$PREV_DEV_FILE" ]; then
        local prev_time prev_rx prev_tx
        read -r prev_time prev_rx prev_tx < "$PREV_DEV_FILE"
        local now_time
        now_time=$(date +%s.%N)
        local time_delta
        time_delta=$(awk -v n="$now_time" -v p="$prev_time" 'BEGIN {print n - p}')
        local rx_delta=$(( cur_rx - prev_rx ))
        local tx_delta=$(( cur_tx - prev_tx ))
        [ "$rx_delta" -lt 0 ] && rx_delta=0
        [ "$tx_delta" -lt 0 ] && tx_delta=0

        rx_rate_str=$(human_rate "$rx_delta" "$time_delta")
        tx_rate_str=$(human_rate "$tx_delta" "$time_delta")
    fi
    echo "$(date +%s.%N) $cur_rx $cur_tx" > "$PREV_DEV_FILE"

    # Human cumulative I/O
    local rx_total_str tx_total_str
    rx_total_str=$(human_bytes "$cur_rx")
    tx_total_str=$(human_bytes "$cur_tx")

    # 6. Render Title & Body
    local card_title=""
    local live_tag=""
    [ "$is_live" -eq 1 ] && live_tag=" [live]"

    if [ "$is_wifi" -eq 1 ]; then
        if [ -n "$wifi_ssid" ]; then
            card_title="📡 makonet${live_tag} • ${wifi_ssid} (${wifi_band:-Wi-Fi})"
        else
            card_title="📡 makonet${live_tag} • Wi-Fi (Scanning / Idle)"
        fi
    elif [ -n "$def_iface" ]; then
        card_title="📡 makonet${live_tag} • ${def_iface} (Ethernet)"
    else
        card_title="📡 makonet${live_tag} • Offline"
    fi

    # Latency color helper
    format_latency() {
        local val="$1"
        local is_p="$2"
        if [ -z "$val" ] || [ "$val" = "timeout" ]; then
            if [ "$is_p" -eq 1 ]; then
                printf "<span foreground=\"#f38ba8\">timeout</span>"
            else
                printf "\033[31mtimeout\033[0m"
            fi
            return
        fi

        local num="${val%%.*}"
        local col_hex="#a6e3a1"
        local col_ansi="\033[32m"
        if [ "$num" -ge 150 ] 2>/dev/null; then
            col_hex="#f38ba8"
            col_ansi="\033[31m"
        elif [ "$num" -ge 50 ] 2>/dev/null; then
            col_hex="#fab387"
            col_ansi="\033[33m"
        fi

        if [ "$is_p" -eq 1 ]; then
            printf "<span foreground=\"%s\"><b>%sms</b></span>" "$col_hex" "$val"
        else
            printf "%b%sms\033[0m" "$col_ansi" "$val"
        fi
    }

    local gw_disp inet_disp
    gw_disp=$(format_latency "$gw_rtt" "$is_pango")
    inet_disp=$(format_latency "$inet_rtt" "$is_pango")

    # Render Body
    if [ "$is_pango" -eq 1 ]; then
        local wifi_line=""
        if [ "$is_wifi" -eq 1 ]; then
            if [ -n "$wifi_ssid" ]; then
                local sig_bar
                sig_bar=$(make_bar "$wifi_sig" 10 1)
                local chan_info=""
                [ -n "$wifi_chan" ] && chan_info="Ch ${wifi_chan}"
                [ -n "$wifi_rate" ] && chan_info="${chan_info:+$chan_info • }${wifi_rate}"
                wifi_line="<span foreground=\"#cba6f7\"><b>WIFI</b></span>  [${sig_bar}] <b>${wifi_sig}%</b>  <span foreground=\"#a6adc8\">${chan_info}</span>"
            else
                wifi_line="<span foreground=\"#cba6f7\"><b>WIFI</b></span>  <span foreground=\"#6c7086\">Not connected to an access point</span>"
            fi
        elif [ -n "$def_iface" ]; then
            wifi_line="<span foreground=\"#cba6f7\"><b>ETH </b></span>  <b>${def_iface}</b>  <span foreground=\"#a6e3a1\">Connected</span>"
        else
            wifi_line="<span foreground=\"#cba6f7\"><b>LINK</b></span>  <span foreground=\"#f38ba8\">No active network link</span>"
        fi

        local gw_str=""
        [ -n "$def_gw" ] && gw_str="<span foreground=\"#6c7086\">gw:</span> ${def_gw}"
        local lan_line="<span foreground=\"#cba6f7\"><b>LAN </b></span>  <b>${local_ip}</b>  ${gw_str}"

        local tail_dot="<span foreground=\"#6c7086\">○</span>"
        local tail_ip_disp="<span foreground=\"#6c7086\">offline</span>"
        if [ -n "$tail_ip" ]; then
            tail_dot="<span foreground=\"#a6e3a1\">●</span>"
            tail_ip_disp="<b>${tail_ip}</b>"
        fi
        local tail_line="<span foreground=\"#cba6f7\"><b>TAIL</b></span>  ${tail_ip_disp}   ${tail_dot} <span foreground=\"#a6adc8\">${tail_status}</span>"

        local ping_line="<span foreground=\"#cba6f7\"><b>PING</b></span>  <span foreground=\"#6c7086\">gw:</span> ${gw_disp}  •  <span foreground=\"#6c7086\">inet:</span> ${inet_disp}"

        local data_line=""
        if [ "$is_live" -eq 1 ] && [ -n "$rx_rate_str" ]; then
            data_line="<span foreground=\"#cba6f7\"><b>RATE</b></span>  <span foreground=\"#89b4fa\">↓ ${rx_rate_str}</span>  •  <span foreground=\"#fab387\">↑ ${tx_rate_str}</span>"
        else
            data_line="<span foreground=\"#cba6f7\"><b>DATA</b></span>  <span foreground=\"#89b4fa\">↓ ${rx_total_str}</span> (Rx)  •  <span foreground=\"#fab387\">↑ ${tx_total_str}</span> (Tx)"
        fi

        echo "$card_title"
        printf "%s\n%s\n%s\n%s\n%s" "$wifi_line" "$lan_line" "$tail_line" "$ping_line" "$data_line"
    else
        # ANSI Terminal Output
        echo -e "\033[1;35m${card_title}\033[0m"

        if [ "$is_wifi" -eq 1 ]; then
            if [ -n "$wifi_ssid" ]; then
                local sig_bar
                sig_bar=$(make_bar "$wifi_sig" 10 0)
                local chan_info=""
                [ -n "$wifi_chan" ] && chan_info="Ch ${wifi_chan}"
                [ -n "$wifi_rate" ] && chan_info="${chan_info:+$chan_info • }${wifi_rate}"
                echo -e "\033[1;35mWIFI \033[0m [${sig_bar}] \033[1m${wifi_sig}%\033[0m  \033[90m${chan_info}\033[0m"
            else
                echo -e "\033[1;35mWIFI \033[0m \033[90mNot connected to an access point\033[0m"
            fi
        elif [ -n "$def_iface" ]; then
            echo -e "\033[1;35mETH  \033[0m \033[1m${def_iface}\033[0m  \033[32mConnected\033[0m"
        else
            echo -e "\033[1;35mLINK \033[0m \033[31mNo active network link\033[0m"
        fi

        local gw_str=""
        [ -n "$def_gw" ] && gw_str="\033[90mgw:\033[0m ${def_gw}"
        echo -e "\033[1;35mLAN  \033[0m \033[1m${local_ip}\033[0m  ${gw_str}"

        local tail_dot="\033[90m○\033[0m"
        local tail_ip_disp="\033[90moffline\033[0m"
        if [ -n "$tail_ip" ]; then
            tail_dot="\033[32m●\033[0m"
            tail_ip_disp="\033[1m${tail_ip}\033[0m"
        fi
        echo -e "\033[1;35mTAIL \033[0m ${tail_ip_disp}   ${tail_dot} \033[37m${tail_status}\033[0m"

        echo -e "\033[1;35mPING \033[0m \033[90mgw:\033[0m ${gw_disp}  •  \033[90minet:\033[0m ${inet_disp}"

        if [ "$is_live" -eq 1 ] && [ -n "$rx_rate_str" ]; then
            echo -e "\033[1;35mRATE \033[0m \033[34m↓ ${rx_rate_str}\033[0m  •  \033[33m↑ ${tx_rate_str}\033[0m"
        else
            echo -e "\033[1;35mDATA \033[0m \033[34m↓ ${rx_total_str}\033[0m (Rx)  •  \033[33m↑ ${tx_total_str}\033[0m (Tx)"
        fi
    fi
}

# ------------------------------------------------------------------------------
# FUZZEL INTERACTIVE NETWORK MENU (-m / --menu)
# ------------------------------------------------------------------------------
launch_fuzzel_menu() {
    dismiss_makonet

    local options="📡 Connect to Wi-Fi Network\n🔄 Refresh / Reconnect Networking\n🔒 Tailscale: Toggle Status\n⚡ Latency Benchmark\n📋 Copy Local IP to Clipboard"

    local choice
    choice=$(echo -e "$options" | fuzzel -d -p "🌐 makonet > " -w 45 -l 6)
    [ -z "$choice" ] && exit 0

    case "$choice" in
        "📡 Connect to Wi-Fi Network")
            notify_msg "📡 makonet" "Scanning Wi-Fi access points..." 1500
            local wifi_list
            wifi_list=$(nmcli -t -f in-use,signal,ssid,chan,freq,security dev wifi list --rescan yes 2>/dev/null | awk -F: '
                NF >= 3 && $3 != "" {
                    in_use = ($1 == "*" ? "● " : "  ");
                    sec = ($6 == "" ? "Open" : $6);
                    freq = ($5 >= 5000 ? "5GHz" : "2.4GHz");
                    printf "%s[%3d%%] %-22s (%s, %s)\n", in_use, $2, $3, freq, sec;
                }' | sort -u -k2,2 -r)

            if [ -z "$wifi_list" ]; then
                notify_msg "📡 makonet" "No Wi-Fi networks found." 2500
                exit 0
            fi

            local selected_net
            selected_net=$(echo -e "$wifi_list" | fuzzel -d -p "📶 Select Wi-Fi > " -w 50 -l 10)
            [ -z "$selected_net" ] && exit 0

            # Extract SSID
            local target_ssid
            target_ssid=$(sed -E 's/^.{7}[[:space:]]*//; s/[[:space:]]*\(.*$//' <<< "$selected_net")

            # Check if known connection
            if nmcli -t -f NAME connection show | grep -Fxq "$target_ssid"; then
                notify_msg "📡 makonet" "Connecting to saved network: ${target_ssid}..." 2000
                if nmcli connection up "$target_ssid" >/dev/null 2>&1; then
                    notify_msg "📡 makonet" "Successfully connected to ${target_ssid}!" 3000
                else
                    notify_msg "📡 makonet" "Failed to connect to ${target_ssid}" 3000
                fi
            else
                # Prompt password
                local pass
                pass=$(fuzzel -d --password -p "🔑 Password for ${target_ssid} > " -w 40)
                notify_msg "📡 makonet" "Connecting to ${target_ssid}..." 2500
                local conn_err
                if [ -n "$pass" ]; then
                    conn_err=$(nmcli dev wifi connect "$target_ssid" password "$pass" 2>&1)
                else
                    conn_err=$(nmcli dev wifi connect "$target_ssid" 2>&1)
                fi
                if [ $? -eq 0 ]; then
                    notify_msg "📡 makonet" "Successfully connected to ${target_ssid}!" 3000
                else
                    notify_msg "📡 makonet" "Error: ${conn_err}" 4000
                fi
            fi
            ;;
        "🔄 Refresh / Reconnect Networking")
            notify_msg "📡 makonet" "Cycling network interface..." 2000
            nmcli networking off && sleep 1 && nmcli networking on
            notify_msg "📡 makonet" "Networking restarted." 2000
            ;;
        "🔒 Tailscale: Toggle Status")
            if tailscale ip -4 >/dev/null 2>&1; then
                notify_msg "📡 makonet" "Disconnecting Tailscale..." 2000
                tailscale down >/dev/null 2>&1 || true
                notify_msg "📡 makonet" "Tailscale disconnected." 2000
            else
                notify_msg "📡 makonet" "Connecting Tailscale..." 2000
                tailscale up >/dev/null 2>&1 || true
                local new_tip
                new_tip=$(tailscale ip -4 2>/dev/null | head -n 1)
                notify_msg "📡 makonet" "Tailscale active: ${new_tip:-connected}" 3000
            fi
            ;;
        "⚡ Latency Benchmark")
            notify_msg "📡 makonet" "Running parallel latency benchmark..." 2500
            local tmp_bench
            tmp_bench=$(mktemp -d /tmp/makonet_bench.XXXXXX)

            # Parallel pings for instant completion
            ping -c 2 -W 1 "192.168.3.1" 2>/dev/null | awk -F'/' '/rtt/ {printf "%.1f ms", $5}' > "$tmp_bench/gw" &
            ping -c 2 -W 1 "1.1.1.1" 2>/dev/null | awk -F'/' '/rtt/ {printf "%.1f ms", $5}' > "$tmp_bench/cf" &
            ping -c 2 -W 1 "8.8.8.8" 2>/dev/null | awk -F'/' '/rtt/ {printf "%.1f ms", $5}' > "$tmp_bench/gg" &
            ping -c 2 -W 1 "9.9.9.9" 2>/dev/null | awk -F'/' '/rtt/ {printf "%.1f ms", $5}' > "$tmp_bench/q9" &
            wait

            local rtt_gw rtt_cf rtt_gg rtt_q9
            rtt_gw=$(cat "$tmp_bench/gw" 2>/dev/null)
            rtt_cf=$(cat "$tmp_bench/cf" 2>/dev/null)
            rtt_gg=$(cat "$tmp_bench/gg" 2>/dev/null)
            rtt_q9=$(cat "$tmp_bench/q9" 2>/dev/null)
            rm -rf "$tmp_bench"

            format_bench_row() {
                local label="$1"
                local val="$2"
                local col="#a6e3a1"
                local disp="$val"
                if [ -z "$val" ]; then
                    col="#f38ba8"
                    disp="timeout"
                elif [[ "${val%%.*}" -ge 150 ]] 2>/dev/null; then
                    col="#f38ba8"
                elif [[ "${val%%.*}" -ge 50 ]] 2>/dev/null; then
                    col="#fab387"
                fi
                printf "<span foreground=\"#cba6f7\">%-24s</span> <span foreground=\"%s\"><b>%s</b></span>" "$label" "$col" "$disp"
            }

            local row1 row2 row3 row4
            row1=$(format_bench_row "Gateway  (192.168.3.1)" "$rtt_gw")
            row2=$(format_bench_row "Cloudflare   (1.1.1.1)" "$rtt_cf")
            row3=$(format_bench_row "Google DNS   (8.8.8.8)" "$rtt_gg")
            row4=$(format_bench_row "Quad9 DNS    (9.9.9.9)" "$rtt_q9")

            local res="${row1}
${row2}
${row3}
${row4}"

            notify_msg "⚡ Latency Benchmark" "$res" 8000
            ;;
        "📋 Copy Local IP to Clipboard")
            local lip
            lip=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4; exit}' | cut -d/ -f1)
            if [ -n "$lip" ]; then
                echo -n "$lip" | wl-copy 2>/dev/null || true
                notify_msg "📋 makonet" "Copied IP: ${lip}" 2000
            fi
            ;;
    esac
    exit 0
}

# ------------------------------------------------------------------------------
# PARSE CLI OPTIONS
# ------------------------------------------------------------------------------
WATCH_MODE=0
PRINT_MODE=0
MENU_MODE=0
DAEMON_INTERNAL=0

for arg in "$@"; do
    case "$arg" in
        --daemon)
            DAEMON_INTERNAL=1
            ;;
        -w|--watch)
            WATCH_MODE=1
            ;;
        -p|--print)
            PRINT_MODE=1
            ;;
        -m|--menu)
            MENU_MODE=1
            ;;
        -h|--help)
            echo "makonet - Ultra-lightweight network & telemetry HUD for Mako / Wayland"
            echo ""
            echo "Usage: makonet [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  (no args)     Toggle network snapshot card (8s auto-dismiss)"
            echo "  -w, --watch   Continuous live HUD (updates every 2s via D-Bus)"
            echo "  -p, --print   Print formatted ANSI telemetry to terminal"
            echo "  -m, --menu    Launch interactive Fuzzel network selector menu"
            echo "  -h, --help    Show this help message"
            exit 0
            ;;
    esac
done

# ------------------------------------------------------------------------------
# FUZZEL MENU MODE (-m / --menu)
# ------------------------------------------------------------------------------
if [ "$MENU_MODE" -eq 1 ]; then
    launch_fuzzel_menu
fi

# ------------------------------------------------------------------------------
# TERMINAL PRINT MODE (-p / --print)
# ------------------------------------------------------------------------------
if [ "$PRINT_MODE" -eq 1 ]; then
    gather_network_data 0 0
    exit 0
fi

# ------------------------------------------------------------------------------
# DAEMON MODE: Background sampler loop (invoked by --watch)
# ------------------------------------------------------------------------------
if [ "$DAEMON_INTERNAL" -eq 1 ]; then
    cleanup() {
        dismiss_makonet
        rm -f "$PID_FILE" "$NOTIF_ID_FILE" "$PREV_DEV_FILE"
        exit 0
    }
    trap cleanup SIGTERM SIGINT EXIT

    notif_id=0
    iteration=0

    while true; do
        # Auto-exit if dismissed or clicked away by user
        if [ "$iteration" -gt 0 ]; then
            if ! makoctl list 2>/dev/null | grep -q "App name: ${APP_NAME}"; then
                cleanup
            fi
        fi

        # Extract data (returns title on line 1, body on remaining lines)
        output=$(gather_network_data 1 1 2.0)
        title=$(head -n 1 <<< "$output")
        body=$(tail -n +2 <<< "$output")

        resp=$(busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
            org.freedesktop.Notifications Notify susssasa{sv}i \
            "$APP_NAME" "$notif_id" "" "$title" "$body" 0 0 0 2>/dev/null)

        if [ $? -eq 0 ] && [[ "$resp" =~ u[[:space:]]+([0-9]+) ]]; then
            notif_id="${BASH_REMATCH[1]}"
            echo "$notif_id" > "$NOTIF_ID_FILE"
        fi

        iteration=$((iteration + 1))
        sleep 2.0
    done
fi

# ------------------------------------------------------------------------------
# TOGGLE CONTROLLER: Check running daemon or visible card
# ------------------------------------------------------------------------------

# 1. Check PID file for running watch daemon
if [ -f "$PID_FILE" ]; then
    DAEMON_PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$DAEMON_PID" ] && kill -0 "$DAEMON_PID" 2>/dev/null; then
        kill "$DAEMON_PID" 2>/dev/null
        rm -f "$PID_FILE" "$NOTIF_ID_FILE" "$PREV_DEV_FILE"
        dismiss_makonet
        exit 0
    fi
fi

# 2. Check process name fallback
EXISTING_PID=$(pgrep -f "makonet --daemon" 2>/dev/null | head -n 1)
if [ -n "$EXISTING_PID" ]; then
    kill "$EXISTING_PID" 2>/dev/null
    rm -f "$PID_FILE" "$NOTIF_ID_FILE" "$PREV_DEV_FILE"
    dismiss_makonet
    exit 0
fi

# 3. Check if card is currently displayed on screen (one-shot mode toggle off)
if makoctl list 2>/dev/null | grep -q "App name: ${APP_NAME}"; then
    dismiss_makonet
    rm -f "$PID_FILE" "$NOTIF_ID_FILE" "$PREV_DEV_FILE"
    exit 0
fi

# ------------------------------------------------------------------------------
# LAUNCH CARD (Toggle ON)
# ------------------------------------------------------------------------------
dismiss_makonet

if [ "$WATCH_MODE" -eq 1 ]; then
    nohup "$0" --daemon >/dev/null 2>&1 &
    DAEMON_PID=$!
    echo "$DAEMON_PID" > "$PID_FILE"
    exit 0
else
    # One-shot notification card (8s timeout or toggle off with keybind)
    output=$(gather_network_data 1 0)
    title=$(head -n 1 <<< "$output")
    body=$(tail -n +2 <<< "$output")

    busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
        org.freedesktop.Notifications Notify susssasa{sv}i \
        "$APP_NAME" 0 "" "$title" "$body" 0 0 8000 >/dev/null 2>&1
    exit 0
fi
