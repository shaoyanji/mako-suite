#!/usr/bin/env bash
# ==============================================================================
# makotop: Ultra-lightweight system monitor HUD using Mako notifications
# Author: Alice & Antigravity
# License: MIT
# Toggle with Mod+Backspace in niri
# ==============================================================================

PID_FILE="/tmp/makotop.pid"
NOTIF_ID_FILE="/tmp/makotop.nid"

dismiss_makotop() {
    makoctl list 2>/dev/null | awk '
        /^Notification [0-9]+:/ { id = $2; sub(":", "", id) }
        /App name: makotop/     { system("makoctl dismiss -n " id " 2>/dev/null") }
    '
}

# ------------------------------------------------------------------------------
# DAEMON MODE: Background sampler loop
# ------------------------------------------------------------------------------
if [ "$1" = "--daemon" ]; then
    cleanup() {
        dismiss_makotop
        rm -f "$PID_FILE" "$NOTIF_ID_FILE"
        exit 0
    }
    trap cleanup SIGTERM SIGINT

    make_bar() {
        local pct=$1
        local width=10
        local filled=$(( pct * width / 100 ))
        [ "$filled" -gt "$width" ] && filled=$width
        [ "$filled" -lt 0 ] && filled=0
        local empty=$(( width - filled ))
        local bar=""
        for ((i=0; i<filled; i++)); do bar="${bar}█"; done
        for ((i=0; i<empty; i++)); do bar="${bar}░"; done
        echo "$bar"
    }

    # Initial CPU sample
    read -r _ u1 n1 s1 i1 w1 q1 sq1 st1 rest < <(head -n1 /proc/stat)
    prev_total=$((u1 + n1 + s1 + i1 + w1 + q1 + sq1 + st1))
    prev_idle=$((i1 + w1))

    notif_id=0
    iteration=0

    while true; do
        # Auto-exit if notification was dismissed or clicked away by the user
        if [ "$iteration" -gt 0 ]; then
            if ! makoctl list 2>/dev/null | grep -q "App name: makotop"; then
                cleanup
            fi
        fi

        # 1. Memory & Swap from /proc/meminfo
        mem_tot=0; mem_avail=0; swap_tot=0; swap_free=0
        while read -r key val rest; do
            case "$key" in
                MemTotal:) mem_tot=$((val / 1024)) ;;
                MemAvailable:) mem_avail=$((val / 1024)) ;;
                SwapTotal:) swap_tot=$((val / 1024)) ;;
                SwapFree:) swap_free=$((val / 1024)) ;;
            esac
        done < /proc/meminfo

        mem_used=$((mem_tot - mem_avail))
        mem_pct=0
        [ "$mem_tot" -gt 0 ] && mem_pct=$((mem_used * 100 / mem_tot))

        swap_used=$((swap_tot - swap_free))
        swap_pct=0
        [ "$swap_tot" -gt 0 ] && swap_pct=$((swap_used * 100 / swap_tot))

        # 2. Top 3 CPU processes
        top_procs=$(ps -eo comm,%cpu --sort=-%cpu --no-headers 2>/dev/null | awk '
            $1 != "ps" && $1 != "awk" && $1 != "head" && $1 != "sleep" && $1 != "makotop" && $1 != "mako-top.sh" {
                printf "%s (%.0f%%)  ", $1, $2
                count++
            }
            count == 3 { exit }
        ')

        # 3. CPU Delta over sampling interval
        read -r _ u2 n2 s2 i2 w2 q2 sq2 st2 rest < <(head -n1 /proc/stat)
        cur_total=$((u2 + n2 + s2 + i2 + w2 + q2 + sq2 + st2))
        cur_idle=$((i2 + w2))

        diff_total=$((cur_total - prev_total))
        diff_idle=$((cur_idle - prev_idle))
        prev_total=$cur_total
        prev_idle=$cur_idle

        cpu_pct=0
        if [ "$diff_total" -gt 0 ]; then
            cpu_pct=$(( (diff_total - diff_idle) * 100 / diff_total ))
        fi
        [ "$cpu_pct" -lt 0 ] && cpu_pct=0
        [ "$cpu_pct" -gt 100 ] && cpu_pct=100

        # 4. Optional Thermal & Battery in title
        header_extra=""
        temp_raw=$(cat /sys/class/thermal/thermal_zone3/temp 2>/dev/null || cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
        if [ -n "$temp_raw" ]; then
            temp_c=$((temp_raw / 1000))
            header_extra=" • ${temp_c}°C"
        fi

        bat_cap=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1)
        if [ -n "$bat_cap" ]; then
            bat_stat=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n1)
            icon="🔋"
            [ "$bat_stat" = "Charging" ] && icon="⚡"
            header_extra="${header_extra} • ${icon}${bat_cap}%"
        fi

        title="📊 makotop${header_extra}"

        # 5. Generate visual bars
        cbar=$(make_bar "$cpu_pct")
        mbar=$(make_bar "$mem_pct")
        sbar=$(make_bar "$swap_pct")

        body="<b>CPU</b> [${cbar}] ${cpu_pct}%
<b>RAM</b> [${mbar}] ${mem_used}M/${mem_tot}M (${mem_pct}%)
<b>SWP</b> [${sbar}] ${swap_used}M/${swap_tot}M (${swap_pct}%)
<b>TOP</b> ${top_procs}"

        # 6. Push / replace notification in Mako via D-Bus
        resp=$(busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
            org.freedesktop.Notifications Notify susssasa{sv}i \
            "makotop" "$notif_id" "" "$title" "$body" 0 0 0 2>/dev/null)

        if [ $? -eq 0 ] && [[ "$resp" =~ u[[:space:]]+([0-9]+) ]]; then
            notif_id="${BASH_REMATCH[1]}"
            echo "$notif_id" > "$NOTIF_ID_FILE"
        fi

        iteration=$((iteration + 1))
        sleep 1.2
    done
fi

# ------------------------------------------------------------------------------
# TOGGLE CONTROLLER
# ------------------------------------------------------------------------------

# 1. Check PID file
if [ -f "$PID_FILE" ]; then
    DAEMON_PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$DAEMON_PID" ] && kill -0 "$DAEMON_PID" 2>/dev/null; then
        kill "$DAEMON_PID" 2>/dev/null
        sleep 0.1
        rm -f "$PID_FILE" "$NOTIF_ID_FILE"
        dismiss_makotop
        exit 0
    fi
fi

# 2. Check by process name fallback
EXISTING_PID=$(pgrep -f "makotop --daemon" 2>/dev/null | head -n 1)
if [ -n "$EXISTING_PID" ]; then
    kill "$EXISTING_PID" 2>/dev/null
    sleep 0.1
    rm -f "$PID_FILE" "$NOTIF_ID_FILE"
    dismiss_makotop
    exit 0
fi

# 3. Not running: Start daemon (Toggle ON)
dismiss_makotop
nohup "$0" --daemon >/dev/null 2>&1 &
DAEMON_PID=$!
echo "$DAEMON_PID" > "$PID_FILE"

exit 0
